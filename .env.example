# Application
APP_NAME="Agentic DNS & Hosting Support Copilot"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
POSTGRES_PASSWORD=change-me-for-compose-only

# External services — not required for Phase 1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=20
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=500
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/support_copilot
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=0.2
DNS_CACHE_TTL_SECONDS=60
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_VERSION=v1
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
SSL_CACHE_TTL_SECONDS=300
HTTP_CACHE_TTL_SECONDS=30
SSL_TIMEOUT_SECONDS=5
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_REDIRECTS=3
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.7
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
RAG_COLLECTION_NAME=support_docs
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

